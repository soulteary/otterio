{
  "name": "otterio-browser",
  "version": "0.0.1",
  "description": "OtterIO Browser",
  "scripts": {
    "test": "jest",
    "dev": "NODE_ENV=dev webpack serve --config webpack.dev.js",
    "build": "NODE_ENV=dev node build.js",
    "release": "NODE_ENV=production node build.js",
    "format": "prettier --write 'app/js/**/*.js' 'webpack.*.js' build.js",
    "format:check": "prettier --check 'app/js/**/*.js' 'webpack.*.js' build.js"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not IE 11"
  ],
  "jest": {
    "testEnvironment": "jsdom",
    "testEnvironmentOptions": {
      "url": "https://localhost:8080"
    },
    "setupFilesAfterEnv": [
      "./app/js/jest/setup.js"
    ],
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/app/js/jest/__mocks__/fileMock.js",
      "\\.(css|scss|less)$": "identity-obj-proxy"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/soulteary/otterio"
  },
  "author": "soulteary",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/soulteary/otterio/issues"
  },
  "homepage": "https://github.com/soulteary/otterio",
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "babel-jest": "^30.5.2",
    "babel-loader": "^10.1.1",
    "babel-plugin-polyfill-corejs3": "^1.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "glob-all": "^3.3.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "less": "^4.9.1",
    "less-loader": "^13.0.0",
    "mini-css-extract-plugin": "^2.10.2",
    "prettier": "^3.9.9",
    "purgecss-webpack-plugin": "^8.0.0",
    "redux-mock-store": "^1.5.5",
    "redux-thunk": "^3.1.0",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0",
    "webpack-merge": "^6.0.1"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@reduxjs/toolkit": "^2.13.0",
    "bootstrap": "^5.3.8",
    "classnames": "^2.5.1",
    "core-js": "^3.50.0",
    "dayjs": "^1.11.23",
    "filesize": "^11.0.25",
    "history": "^5.3.0",
    "jwt-decode": "^4.0.0",
    "local-storage-fallback": "^5.0.0",
    "mime-db": "^1.54.0",
    "mime-types": "^3.0.2",
    "path-browserify": "^1.0.1",
    "query-string": "^9.5.1",
    "react": "^19.3.0",
    "react-bootstrap": "^2.10.10",
    "react-copy-to-clipboard": "^5.1.1",
    "react-dom": "^19.3.0",
    "react-dropzone": "^20.1.2",
    "react-infinite-scroller": "^1.2.6",
    "react-qr-code": "^2.2.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.4"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "packageManager": "bun@1.4.2"
}
